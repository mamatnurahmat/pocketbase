# ─────────────────────────────────────────────────────────────
# Contoh environment — salin ke `.env` lalu sesuaikan.
#   cp .env.example .env
#
# Nilai PUBLIC_* dibaca Vite saat BUILD (bukan runtime), jadi
# mengubahnya butuh rebuild image / `pnpm build` ulang.
# ─────────────────────────────────────────────────────────────

# URL PocketBase public. Diakses langsung dari browser.
PUBLIC_PB_URL=https://prestige2.sawangan.web.id

# URL Flask API (approve tagihan, upload bukti, upload mutasi).
PUBLIC_API_URL=https://api.sawangan.web.id

# ── Opsional: override Makefile ───────────────────────────────
# Target environment build → memilih file `.env.<ENV>` di dalam image.
# BUILD_ENV=production

# Port host yang di-map ke nginx (container listen :80).
# PORT=8080

# Target platform build. Wajib linux/amd64 agar cocok dengan node deploy.
# PLATFORM=linux/amd64

# Registry & nama image (default: newrahmat/p2s-app:latest).
# ORG_REGISTRY=newrahmat
# IMAGE_NAME=p2s-app
# IMAGE_TAG=latest
