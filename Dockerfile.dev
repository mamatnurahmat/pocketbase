# Dockerfile — Development Mode
# ============================================================
# Pakai node:22-alpine (sesuai `engines.node >= 22` di package.json)
# dan install pnpm global saat BUILD (bukan corepack saat runtime —
# corepack terkenal bisa menggantung saat download pnpm di start-up;
# saat build, jaringan host terbukti lancar).
#
# Versi pnpm di-pin sama dengan `packageManager` di package.json.
#
# Dependensi TIDAK di-install saat build: source di-bind-mount ke
# /app (menimpa isi image), jadi install dilakukan saat container
# start (lihat `command` di docker-compose.dev.yml) dengan cache
# pnpm-store di volume `client_pnpm_store`.
FROM node:22-alpine

ENV PNPM_VERSION=9.15.9

WORKDIR /app

RUN npm install -g pnpm@${PNPM_VERSION}

EXPOSE 5173 9229

CMD ["pnpm", "dev"]
