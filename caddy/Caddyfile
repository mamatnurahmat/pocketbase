{
	order coraza_waf first
}

# ============================================================
# Caddy WAF - 2026-08-25
# Domain aktif: api, prestige2, argocd, vault, vault-web,
# photos, keyclock, k8s, llm, pi, netbird, dev (client-v2)
# ============================================================

# WAF untuk domain publik
api.sawangan.web.id {
	coraza_waf {
		load_owasp_crs
		directives `
            Include /ruleset/coraza.conf
            Include /ruleset/owasp-crs/crs-setup.conf.example
            Include /ruleset/owasp-crs/rules/*.conf
            SecRuleEngine On
            SecAuditLog /audit/waf-audit.log
            SecAuditEngine RelevantOnly
            SecAuditLogRelevantStatus "^(?:(5|4)(0|1)[0-9])$"
            SecRequestBodyAccess On
            SecResponseBodyAccess On
            SecResponseBodyMimeType text/plain text/html text/xml application/json
        `
	}
	reverse_proxy pocketbase-api:8888
}

prestige2.sawangan.web.id {
	coraza_waf {
		load_owasp_crs
		directives `
            Include /ruleset/coraza.conf
            Include /ruleset/owasp-crs/crs-setup.conf.example
            Include /ruleset/owasp-crs/rules/*.conf
            SecRuleEngine On
            SecAuditLog /audit/waf-audit.log
            SecAuditEngine RelevantOnly
            SecAuditLogRelevantStatus "^(?:(5|4)(0|1)[0-9])$"
            SecRequestBodyAccess On
            # Izinkan metode PATCH (dipakai PocketBase untuk update record)
            SecRuleRemoveById 911100
        `
	}
	reverse_proxy pocketbase:8090
}

# Client-v2 (SvelteKit + nginx) - container p2s-app-production di network client-v2_default
dev.sawangan.web.id {
	reverse_proxy p2s-app-production:80
}

